colourful: true

filekinds:
  normal: {foreground: Default}
  directory: {foreground: "#{{base0D}}", is_bold: true}
  symlink: {foreground: "#{{base0C}}"}
  pipe: {foreground: "#{{base0A}}"}
  block_device: {foreground: "#{{base0A}}", is_bold: true}
  char_device: {foreground: "#{{base0A}}", is_bold: true}
  socket: {foreground: "#{{base08}}", is_bold: true}
  special: {foreground: "#{{base0A}}"}
  executable: {foreground: "#{{base0B}}", is_bold: true}
  mount_point: {foreground: "#{{base0D}}", is_bold: true, is_underline: true}

perms:
  user_read: {foreground: "#{{base0A}}", is_bold: true}
  user_write: {foreground: "#{{base08}}", is_bold: true}
  user_execute_file: {foreground: "#{{base0B}}", is_bold: true, is_underline: true}
  user_execute_other: {foreground: "#{{base0B}}", is_bold: true}
  group_read: {foreground: "#{{base0A}}"}
  group_write: {foreground: "#{{base08}}"}
  group_execute: {foreground: "#{{base0B}}"}
  other_read: {foreground: "#{{base0A}}"}
  other_write: {foreground: "#{{base08}}"}
  other_execute: {foreground: "#{{base0B}}"}
  special_user_file: {foreground: "#{{base0E}}"}
  special_other: {foreground: "#{{base0E}}"}
  attribute: {foreground: Default}

size:
  major: {foreground: "#{{base0B}}", is_bold: true}
  minor: {foreground: "#{{base0B}}"}
  number_byte: {foreground: "#{{base0B}}"}
  number_kilo: {foreground: "#{{base0B}}"}
  number_mega: {foreground: "#{{base14}}"}
  number_giga: {foreground: "#{{base13}}"}
  number_huge: {foreground: "#{{base12}}"}
  unit_byte: {foreground: "#{{base04}}"}
  unit_kilo: {foreground: "#{{base04}}"}
  unit_mega: {foreground: "#{{base04}}"}
  unit_giga: {foreground: "#{{base04}}"}
  unit_huge: {foreground: "#{{base04}}"}

users:
  user_you: {foreground: "#{{base0A}}", is_bold: true}
  user_root: {foreground: "#{{base08}}"}
  user_other: {foreground: Default}
  group_yours: {foreground: "#{{base0A}}"}
  group_other: {foreground: Default}
  group_root: {foreground: "#{{base08}}"}

links:
  normal: {foreground: "#{{base08}}", is_bold: true}
  multi_link_file: {foreground: "#{{base08}}", background: "#{{base02}}"}

git:
  new: {foreground: "#{{base0B}}"}
  modified: {foreground: "#{{base0D}}"}
  deleted: {foreground: "#{{base08}}"}
  renamed: {foreground: "#{{base0A}}"}
  typechange: {foreground: "#{{base0E}}"}
  ignored: {foreground: "#{{base03}}"}
  conflicted: {foreground: "#{{base12}}"}

git_repo:
  branch_main: {foreground: "#{{base0B}}"}
  branch_other: {foreground: "#{{base0A}}"}
  git_clean: {foreground: "#{{base0B}}"}
  git_dirty: {foreground: "#{{base0A}}"}

file_type:
  image: {foreground: "#{{base0E}}"}
  video: {foreground: "#{{base17}}"}
  music: {foreground: "#{{base0C}}"}
  lossless: {foreground: "#{{base15}}"}
  crypto: {foreground: "#{{base0B}}", is_bold: true}
  document: {foreground: "#{{base05}}"}
  compressed: {foreground: "#{{base08}}"}
  temp: {foreground: "#{{base03}}"}
  compiled: {foreground: "#{{base09}}"}
  build: {foreground: "#{{base0A}}", is_bold: true, is_underline: true}
  source: {foreground: "#{{base13}}"}

punctuation: {foreground: "#{{base03}}"}
date: {foreground: "#{{base0D}}"}
inode: {foreground: "#{{base0E}}"}
blocks: {foreground: "#{{base0C}}"}
header: {foreground: Default, is_underline: true}
octal: {foreground: "#{{base0E}}"}
flags: {foreground: Default}
symlink_path: {foreground: "#{{base0C}}"}
control_char: {foreground: "#{{base08}}"}
broken_symlink: {foreground: "#{{base08}}"}
broken_path_overlay: {foreground: Default, is_underline: true}
